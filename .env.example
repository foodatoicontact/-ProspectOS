NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Discovery: empty key leaves only the explicitly synthetic test provider.
BRAVE_SEARCH_API_KEY=
# Comma-separated official website hosts whose access you have authorized.
DISCOVERY_ALLOWED_HOSTS=

# BYOK: AES-256-GCM master key, server-only, never NEXT_PUBLIC_. Generate with: openssl rand -base64 32
# Without it, saving a BYOK provider credential fails (CONFIGURATION_REQUIRED); nothing else is affected.
BYOK_MASTER_KEY=
