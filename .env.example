NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never NEXT_PUBLIC_): limited privileged operations, see SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Discovery: empty key leaves only the explicitly synthetic test provider.
BRAVE_SEARCH_API_KEY=
# Operator override: comma-separated website hosts whose access you have authorized (any prospect).
DISCOVERY_ALLOWED_HOSTS=
# "true" (exactly) lets a prospect be analyzed when ProspectOS itself discovered its own site and the user
# accepted it (see docs/DYNAMIC_SAFE_ANALYSIS.md). Anything else keeps it off; the allowlist still applies.
DISCOVERY_DYNAMIC_ANALYSIS_ENABLED=

# BYOK: AES-256-GCM master key, server-only, never NEXT_PUBLIC_. Generate with: openssl rand -base64 32
# Without it, saving a BYOK provider credential fails (CONFIGURATION_REQUIRED); nothing else is affected.
BYOK_MASTER_KEY=

# Stripe Billing (server-only, never NEXT_PUBLIC_; see docs/STRIPE_BILLING.md). A TEST key (sk_test_…) is
# refused on Production (VERCEL_ENV=production); a LIVE key is refused everywhere else, and on Production
# unless BILLING_ALLOW_LIVE=true. Price ids are the monthly EUR prices: BETA = 49 € HT, PRO = 99 € HT.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BETA=
STRIPE_PRICE_PRO=
# "true" (exactly) shows the self-service offers and opens Checkout. Unset: manual activation, as before.
BILLING_ENABLED=
# "false" closes the 49 € offer to new customers; existing BETA subscribers keep their price.
BILLING_BETA_CHECKOUT_OPEN=
# "true" only once Stripe Tax is configured (origin address, registrations) in the Stripe account.
STRIPE_AUTOMATIC_TAX=
# Optional: a Customer Portal configuration id (bpc_…); default portal configuration otherwise.
STRIPE_PORTAL_CONFIGURATION=
# Optional: public https origin used for Stripe return URLs (default: the request's own origin).
APP_BASE_URL=
BILLING_ALLOW_LIVE=

# Signaux SIRENE (src/registry-signals, migration 038; server-only, never NEXT_PUBLIC_). "true" (exactly, or "1")
# opens the routes; anything else answers 404. The Google Places API (New) key is read by the server only, sent in a
# header, never logged; without it a search is refused before any Discovery unit is consumed.
REGISTRY_SIGNALS_ENABLED=
GOOGLE_PLACES_API_KEY=
# Optional (defaults): register cache 86400 s (database), Google cache 3600 s (memory only, never stored),
# register pace 150 ms between requests (~7/s), 429 backoff 500 ms doubling up to 8000 ms, 4 retries.
REGISTRY_SIGNALS_SIRENE_CACHE_TTL_S=
REGISTRY_SIGNALS_PLACES_CACHE_TTL_S=
REGISTRY_SIGNALS_SIRENE_MIN_INTERVAL_MS=
REGISTRY_SIGNALS_PLACES_MIN_INTERVAL_MS=
REGISTRY_SIGNALS_MAX_RETRIES=
REGISTRY_SIGNALS_BACKOFF_BASE_MS=
REGISTRY_SIGNALS_BACKOFF_MAX_MS=
# Optional: replaces the default presets entirely (same shape as src/registry-signals/presets.defaults.ts), as JSON.
REGISTRY_SIGNAL_PRESETS_JSON=
